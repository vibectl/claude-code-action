# CI smoke test image for CCA executability validation
#
# Lightweight image that validates CCA source code is executable with Bun
# inside a container. Uses the same Bun version as production (pinned in
# the production Dockerfile) and installs CCA from the local checkout
# (not from GitHub) to validate the current commit.
#
# This image is NOT the production image — it validates CCA code works in
# a container context. The production Dockerfile lives in the backend repo
# (containers/claude-code-runner/Dockerfile) and includes Claude Code CLI,
# language runtimes, and 9-layer hardening.
#
# Usage (CI):
#   docker build -f ci/Dockerfile.smoke-test -t cca-smoke-test .
#   docker run --rm cca-smoke-test

FROM debian:trixie-slim

ARG BUN_VERSION=1.2.12

# Minimal system dependencies for Bun and git (CCA uses git operations)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Bun runtime (same version as production Dockerfile)
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash -s -- "bun-v${BUN_VERSION}"

# Create non-root user matching production (UID 1000, sandbox)
RUN useradd --create-home --uid 1000 --shell /bin/bash sandbox

# Install CCA source from local checkout (mirrors production /opt/cca layout)
RUN mkdir -p /opt/cca
COPY src/ /opt/cca/src/
COPY base-action/ /opt/cca/base-action/
COPY package.json bun.lock tsconfig.json /opt/cca/
COPY ci/smoke-test.ts /opt/cca/ci/smoke-test.ts

# Install production dependencies
WORKDIR /opt/cca
RUN bun install --production --frozen-lockfile

# Ensure sandbox user can read CCA source (matches production permissions)
RUN chown -R root:sandbox /opt/cca && chmod -R g+rX /opt/cca

# Switch to non-root user (matches production execution model)
USER sandbox

# Run the smoke test
CMD ["bun", "run", "/opt/cca/ci/smoke-test.ts"]
